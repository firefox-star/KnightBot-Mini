# KnightBot-Mini environment variables — copy to .env (local) or set on your hosting panel (Railway/Heroku)

# ── AI providers (FREE tiers — at least one is enough) ─────────────────────
# Zhipu GLM (open.bigmodel.cn). The glm-4.5-flash model is FREE.
GLM_API_KEY=
GLM_MODEL=glm-4.5-flash

# OpenRouter (openrouter.ai). Model ids ending in ":free" cost nothing.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# ── Web dashboard ──────────────────────────────────────────────────────────
# Password to open the dashboard (if empty, the built-in default is used)
DASHBOARD_PASSWORD=
